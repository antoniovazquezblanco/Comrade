<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Builds COMrade-<version>-win-x64.msi from a self-contained publish of the app, e.g.:
       dotnet publish COMrade/COMrade.csproj -c Release -p:Platform=x64 -p:SelfContained=true -o publish/COMrade
       dotnet build COMrade.Installer -c Release -p:AppFolder=../publish/COMrade -p:ProductVersion=0.3.0
       WiX 5: later versions ask users to accept the Open Source Maintenance Fee agreement. -->
  <PropertyGroup>
    <OutputName>COMrade</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Always bin\<configuration>\en-US\COMrade.msi: CI runners set PLATFORM, which would add a
         platform folder. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppFolder Condition="'$(AppFolder)' == ''">..\publish\COMrade</AppFolder>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <AppFolderFull>$([System.IO.Path]::GetFullPath('$(AppFolder)'))</AppFolderFull>
    <DefineConstants>ProductVersion=$(ProductVersion);AppFolder=$(AppFolderFull)</DefineConstants>
    <!-- ICE03: some Windows App SDK files declare more languages than the column holds; it only
         breaks ties between files of equal version. ICE57: the Start menu entry's key path is in
         HKMU, which follows the scope chosen at install time; the check cannot know that. -->
    <SuppressIces>ICE03;ICE57</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <!-- MinVer from Directory.Build.props does not apply: an MSI version must be plain numbers. -->
  <ItemGroup>
    <PackageReference Remove="MinVer" />
  </ItemGroup>

</Project>
