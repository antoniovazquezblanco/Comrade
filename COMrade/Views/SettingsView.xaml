<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="COMrade.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:COMrade.Views"
    xmlns:ui="using:Windows.UI"
    xmlns:vm="using:COMrade.ViewModels">

    <UserControl.Resources>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <!-- Centred by columns, as the port list. -->
        <Grid Margin="24,24,24,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1000*" MaxWidth="680" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tabs" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="How tabs behave when there are more than fit in the window."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <RadioButton
                            Content="Compact: only the selected tab shows its full title, the others show their port"
                            GroupName="TabMode"
                            IsChecked="{x:Bind ViewModel.IsCompactTabs, Mode=TwoWay}" />
                        <RadioButton
                            Content="Scrolling: every tab keeps its full title and the tab strip scrolls"
                            GroupName="TabMode"
                            IsChecked="{x:Bind ViewModel.IsScrollingTabs, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Terminal" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Font, colours and cursor of every terminal; open tabs change at once."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Editable: any installed font can be typed, not only the fixed-pitch ones listed. -->
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                Header="Font"
                                IsEditable="True"
                                ItemsSource="{x:Bind vm:SettingsTabViewModel.FontFamilies}"
                                SelectedItem="{x:Bind ViewModel.FontFamily, Mode=OneWay}"
                                Text="{x:Bind ViewModel.FontFamily, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Column="1"
                                Header="Size"
                                Maximum="{x:Bind ViewModel.MaximumFontSize}"
                                Minimum="{x:Bind ViewModel.MinimumFontSize}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                Header="Colour scheme"
                                ItemsSource="{x:Bind vm:SettingsTabViewModel.ColorSchemeNames}"
                                SelectedIndex="{x:Bind ViewModel.ColorSchemeIndex, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="Cursor"
                                ItemsSource="{x:Bind vm:SettingsTabViewModel.CursorOptions}"
                                SelectedIndex="{x:Bind ViewModel.CursorIndex, Mode=TwoWay}" />
                        </Grid>
                        <!-- Preview in the chosen font and colours, with the 16 colours devices can use. -->
                        <Border Padding="14,10" CornerRadius="4">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Bind ViewModel.PreviewBackground, Mode=OneWay}" />
                            </Border.Background>
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}"
                                    FontSize="{x:Bind ViewModel.PreviewFontSize, Mode=OneWay}"
                                    Text="U-Boot 2026.10 (Oct 31 2026)&#x0a;Hit any key to stop autoboot:  3">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{x:Bind ViewModel.PreviewForeground, Mode=OneWay}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.PreviewPalette, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            MaximumRowsOrColumns="8"
                                            MinColumnSpacing="4"
                                            MinItemHeight="14"
                                            MinItemWidth="24"
                                            MinRowSpacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="ui:Color">
                                            <Rectangle
                                                Width="24"
                                                Height="14"
                                                RadiusX="2"
                                                RadiusY="2">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{x:Bind}" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Logging" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Log in a tab saves what its terminal shows to a text file, one file each time logging starts."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="Folder"
                                PlaceholderText="{x:Bind ViewModel.DefaultLogFolder}"
                                Text="{x:Bind ViewModel.LogFolder, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="OnBrowseLogFolderClick"
                                Content="Browse" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                                Content="Open" />
                        </Grid>
                        <StackPanel>
                            <CheckBox Content="Start each line with the time" IsChecked="{x:Bind ViewModel.LogTimestamps, Mode=TwoWay}" />
                            <CheckBox Content="Keep colour and cursor codes" IsChecked="{x:Bind ViewModel.LogKeepColourCodes, Mode=TwoWay}" />
                            <CheckBox
                                Content="Ask where to save each log"
                                IsChecked="{x:Bind ViewModel.LogAskWhereToSave, Mode=TwoWay}"
                                ToolTipService.ToolTip="Logs started when a port opens still go to the folder above" />
                            <CheckBox Content="Start logging when a port opens" IsChecked="{x:Bind ViewModel.LogWhenPortOpens, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="AI assistants" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Let AI assistants such as Claude Code use serial devices through COMrade (MCP). What they send and receive shows in the device's tab, where you can type at any time. Assistants read what devices print, so let them use only devices whose output you trust."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <RadioButton
                                Content="Off"
                                GroupName="AiAccess"
                                IsChecked="{x:Bind ViewModel.IsAiOff, Mode=TwoWay}" />
                            <RadioButton
                                Content="Per tab: only devices whose tab has MCP turned on in its toolbar"
                                GroupName="AiAccess"
                                IsChecked="{x:Bind ViewModel.IsAiPerTab, Mode=TwoWay}" />
                            <RadioButton
                                Content="All ports: assistants can open and use any port"
                                GroupName="AiAccess"
                                IsChecked="{x:Bind ViewModel.IsAiAllPorts, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.AiStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <!-- How to add COMrade to the chosen client, with this installation's paths. -->
                        <StackPanel Spacing="8">
                            <ComboBox
                                MinWidth="200"
                                Header="Add COMrade to"
                                ItemsSource="{x:Bind vm:SettingsTabViewModel.McpClientNames}"
                                SelectedIndex="{x:Bind ViewModel.McpClientIndex, Mode=TwoWay}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.McpClient.Steps, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AcceptsReturn="True"
                                    AutomationProperties.Name="Command or configuration to copy"
                                    FontFamily="Cascadia Mono"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.McpClient.Snippet, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Command="{x:Bind ViewModel.CopyMcpClientSnippetCommand}"
                                    Content="Copy" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.McpClient.Note, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="When an assistant needs COMrade while it is closed, it starts COMrade, unless AI access is off."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="New devices" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Used the first time a device is opened. Devices COMrade has seen keep their own settings."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <views:DeviceSettingsForm Editor="{x:Bind ViewModel.NewDevice}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Remembered devices" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Each device keeps the settings it was last used with. Forget a device to start it again with the new-device settings."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Command="{x:Bind ViewModel.ForgetAllCommand}"
                                Content="Forget all"
                                IsEnabled="{x:Bind ViewModel.HasRememberedDevices, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No devices remembered yet."
                            Visibility="{x:Bind ViewModel.HasNoRememberedDevices, Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.RememberedDevices}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:RememberedDeviceItem">
                                    <Grid
                                        Padding="12,8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        ColumnSpacing="12"
                                        CornerRadius="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Detail}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Click="OnForgetClick"
                                            Content="Forget"
                                            Tag="{x:Bind Key}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Updates" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="COMrade asks GitHub for its latest release and tells you when a newer one is out. The request carries COMrade's version and nothing else."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Content="Check for updates once a day" IsChecked="{x:Bind ViewModel.CheckForUpdatesAutomatically, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                Content="Check now"
                                IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" />
                            <HyperlinkButton
                                Content="Download"
                                NavigateUri="{x:Bind ViewModel.UpdatePage, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasUpdate, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" />
                        <TextBlock Text="{x:Bind ViewModel.Version}" />
                        <StackPanel Margin="-12,4,0,0" Orientation="Horizontal">
                            <HyperlinkButton Content="Repository" NavigateUri="{x:Bind ViewModel.RepositoryUri}" />
                            <HyperlinkButton Content="Report an issue" NavigateUri="{x:Bind ViewModel.IssuesUri}" />
                            <HyperlinkButton Content="MIT License" NavigateUri="{x:Bind ViewModel.LicenseUri}" />
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenThirdPartyNoticesCommand}" Content="Third-party notices" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
