<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="COMrade.Views.DriverHelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fix the PL2303 driver">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            x:Name="DragRegion"
            Padding="14,0"
            Orientation="Horizontal"
            Spacing="8">
            <Image
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/TitleBarIcon.png" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Fix the PL2303 driver" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Padding="24,8,24,16"
            Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon
                    FontSize="20"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    x:Name="Heading"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="Cause" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap">
                Use another adapter (CH340, CP210x, FTDI or a current PL2303), or install Prolific driver 3.3.2.102, the last one that accepts these chips:
            </TextBlock>
            <TextBlock TextWrapping="Wrap">
                1. Get it from a source you trust: Prolific no longer publishes it.<LineBreak />
                2. In Device Manager, right-click the adapter and choose <Bold>Update driver</Bold>, <Bold>Browse my computer</Bold>, <Bold>Let me pick</Bold>.<LineBreak />
                3. Pick version 3.3.2.102 (or <Bold>Have Disk</Bold>), then replug the adapter.
            </TextBlock>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                If Windows Update installs the newer driver again, repeat steps 2 and 3.
            </TextBlock>
        </StackPanel>

        <Grid
            Grid.Row="2"
            Padding="24,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                Click="OnOpenDeviceManagerClick"
                Content="Open Device Manager"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Grid.Column="2"
                Click="OnCloseClick"
                Content="Close" />
        </Grid>
    </Grid>
</Window>
