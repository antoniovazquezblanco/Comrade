<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="COMrade.Views.DeviceTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:COMrade.Controls"
    xmlns:views="using:COMrade.Views"
    xmlns:vm="using:COMrade.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar. -->
        <StackPanel
            Padding="8,6"
            Orientation="Horizontal"
            Spacing="6">
            <DropDownButton x:Name="PortButton" ToolTipService.ToolTip="Port settings">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PortName, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ToolbarSummary, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <!-- A window of its own: the terminal below is a native window that hides anything drawn in the main window. -->
                    <Flyout Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="False">
                        <Flyout.FlyoutPresenterStyle>
                            <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <!-- A flyout is at most 456 wide, its padding and border included. -->
                        <StackPanel Width="416" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Header, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <!-- Here rather than in the form: the new-device defaults of the settings page have no device to listen to. -->
                                <Button
                                    Grid.Column="1"
                                    Click="OnDetectSpeedClick"
                                    IsEnabled="{x:Bind ViewModel.CanDetectSpeed, Mode=OneWay}"
                                    ToolTipService.ToolTip="Listen to the device at each common speed and keep the one its output reads as text at">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xEC4A;" />
                                        <TextBlock Text="Detect speed" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <views:DeviceSettingsForm Editor="{x:Bind ViewModel.Editor}" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <!-- Tooltips name the keys of the shortcuts, see ApplySettings. -->
            <Button
                x:Name="OpenPortButton"
                Command="{x:Bind ViewModel.OpenCommand}"
                Content="Open port"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.CanOpen, Mode=OneWay}" />
            <Button
                x:Name="ClosePortButton"
                Command="{x:Bind ViewModel.CloseCommand}"
                Content="Close port"
                Visibility="{x:Bind ViewModel.CanClose, Mode=OneWay}" />
            <AppBarSeparator />
            <ToggleButton
                Content="DTR"
                IsChecked="{x:Bind ViewModel.IsDtr, Mode=TwoWay}"
                ToolTipService.ToolTip="Data Terminal Ready: kept while the tab is open and set again when the port reopens" />
            <ToggleButton
                Content="RTS"
                IsChecked="{x:Bind ViewModel.IsRts, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.CanSetRts, Mode=OneWay}"
                ToolTipService.ToolTip="Request To Send: kept while the tab is open and set again when the port reopens. RTS/CTS flow control drives it itself." />
            <Button
                x:Name="BreakButton"
                AutomationProperties.Name="Break"
                Command="{x:Bind ViewModel.BreakCommand}"
                Content="BRK"
                IsEnabled="{x:Bind ViewModel.IsOpen, Mode=OneWay}" />
            <AppBarSeparator />
            <Button x:Name="ClearButton" Command="{x:Bind ViewModel.ClearCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE894;" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
            <Button
                x:Name="FindButton"
                AutomationProperties.Name="Find"
                Click="OnFindClick"
                IsEnabled="{x:Bind ViewModel.CanFind, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE721;" />
                    <TextBlock Text="Find" />
                </StackPanel>
            </Button>
            <ToggleButton
                x:Name="LogButton"
                AutomationProperties.Name="Log"
                IsChecked="{x:Bind ViewModel.IsLogging, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE7C8;" />
                    <TextBlock Text="Log" />
                </StackPanel>
            </ToggleButton>
            <!-- What the tab shows, remembered for the device. -->
            <AppBarSeparator />
            <DropDownButton AutomationProperties.Name="View" ToolTipService.ToolTip="What the tab shows">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE890;" />
                    <TextBlock Text="{x:Bind ViewModel.ViewName, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <!-- A window of its own: the terminal below is a native window that hides anything drawn in the main window. -->
                    <MenuFlyout Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="False">
                        <RadioMenuFlyoutItem
                            Click="OnTerminalViewClick"
                            GroupName="View"
                            IsChecked="{x:Bind ViewModel.IsTerminalView, Mode=OneWay}"
                            Text="Terminal"
                            ToolTipService.ToolTip="The output as the device means it to look" />
                        <RadioMenuFlyoutItem
                            Click="OnAnalysisViewClick"
                            GroupName="View"
                            IsChecked="{x:Bind ViewModel.IsAnalysisView, Mode=OneWay}"
                            Text="Analysis"
                            ToolTipService.ToolTip="What went over the port both ways, by time and sender" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <!-- While AI access is set to per tab in the settings. -->
            <AppBarSeparator Visibility="{x:Bind ViewModel.ShowMcpToggle, Mode=OneWay}" />
            <ToggleButton
                AutomationProperties.Name="MCP"
                IsChecked="{x:Bind ViewModel.IsMcpEnabled, Mode=TwoWay}"
                ToolTipService.ToolTip="Let AI assistants use this device through MCP. Remembered for the device."
                Visibility="{x:Bind ViewModel.ShowMcpToggle, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE99A;" />
                    <TextBlock Text="MCP" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- Bars, in their own row: nothing may be drawn over the terminal. -->
        <StackPanel Grid.Row="1">
            <InfoBar
                Title="{x:Bind ViewModel.WaitingTitle, Mode=OneWay}"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.ShowWaitingBar, Mode=OneWay}"
                Message="{x:Bind ViewModel.WaitingMessage, Mode=OneWay}"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.OpenCommand}" Content="Reconnect now" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.ShowErrorBar, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.OpenCommand}" Content="Try again" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                Title="Detecting the speed"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsDetectingSpeed, Mode=OneWay}"
                Message="{x:Bind ViewModel.DetectingSpeedText, Mode=OneWay}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.StopDetectingSpeedCommand}" Content="Stop" />
                </InfoBar.ActionButton>
                <CheckBox
                    Margin="0,0,0,8"
                    Content="Press Enter at each speed, for a device waiting at a prompt"
                    IsChecked="{x:Bind ViewModel.PressEnterWhileDetecting, Mode=TwoWay}" />
            </InfoBar>
            <InfoBar
                Title="{x:Bind ViewModel.SpeedDetectedTitle, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.ShowSpeedDetectedBar, Mode=TwoWay}"
                Message="COMrade keeps this speed for the device."
                Severity="Success" />
            <InfoBar
                Title="{x:Bind ViewModel.SpeedNotDetectedTitle, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.ShowSpeedNotDetectedBar, Mode=TwoWay}"
                Message="{x:Bind ViewModel.SpeedNotDetectedMessage, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                Title="The driver rejected these settings"
                IsOpen="{x:Bind ViewModel.ShowSettingsRejectedBar, Mode=TwoWay}"
                Message="The port keeps its previous settings. Try another speed or frame setting."
                Severity="Warning" />
            <InfoBar
                Title="Logging could not start"
                IsOpen="{x:Bind ViewModel.ShowLogErrorBar, Mode=TwoWay}"
                Message="{x:Bind ViewModel.LogError, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>

        <!-- The terminal or the analysis, and the find panel beside them: nothing may be drawn over the terminal. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:TerminalView x:Name="Terminal" />
            <controls:TrafficPane x:Name="TrafficPane" Visibility="Collapsed" />
            <Grid
                Grid.Column="1"
                Width="320"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                KeyDown="OnFindPanelKeyDown"
                RowSpacing="8"
                Visibility="{x:Bind ViewModel.Find.IsOpen, Mode=OneWay}">
                <!-- Every button of the panel as tall as the find box; the icon buttons square. -->
                <Grid.Resources>
                    <Style x:Key="FindIconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                    <Style x:Key="FindIconToggleButtonStyle" BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Find" />
                    <Button
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Close find"
                        Click="OnCloseFindClick"
                        Style="{StaticResource FindIconButtonStyle}"
                        ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <!-- The find box and its options, as toggles beside it. -->
                <Grid Grid.Row="1" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Enter: next match, Shift+Enter: previous. -->
                    <TextBox
                        x:Name="FindBox"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Find in the output"
                        KeyDown="OnFindKeyDown"
                        PlaceholderText="Find in the output"
                        Text="{x:Bind ViewModel.Find.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleButton
                        Grid.Column="1"
                        AutomationProperties.Name="Match case"
                        IsChecked="{x:Bind ViewModel.Find.MatchCase, Mode=TwoWay}"
                        Style="{StaticResource FindIconToggleButtonStyle}"
                        ToolTipService.ToolTip="Match case">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Aa" />
                    </ToggleButton>
                    <ToggleButton
                        Grid.Column="2"
                        AutomationProperties.Name="Highlight in the terminal"
                        IsChecked="{x:Bind ViewModel.Find.Highlight, Mode=TwoWay}"
                        Style="{StaticResource FindIconToggleButtonStyle}"
                        ToolTipService.ToolTip="Highlight the matches in the terminal">
                        <FontIcon FontSize="14" Glyph="&#xE7E6;" />
                    </ToggleButton>
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.Find.CountText, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Previous match"
                        Command="{x:Bind ViewModel.Find.PreviousCommand}"
                        Style="{StaticResource FindIconButtonStyle}"
                        ToolTipService.ToolTip="Previous match (Shift+Enter)">
                        <FontIcon FontSize="12" Glyph="&#xE70E;" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Next match"
                        Command="{x:Bind ViewModel.Find.NextCommand}"
                        Style="{StaticResource FindIconButtonStyle}"
                        ToolTipService.ToolTip="Next match (Enter)">
                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Search again"
                        Command="{x:Bind ViewModel.Find.RefreshCommand}"
                        Style="{StaticResource FindIconButtonStyle}"
                        ToolTipService.ToolTip="Search again, including what arrived since">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        AutomationProperties.Name="Copy line"
                        Command="{x:Bind ViewModel.Find.CopyLineCommand}"
                        Style="{StaticResource FindIconButtonStyle}"
                        ToolTipService.ToolTip="Copy the line of the selected match">
                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                    </Button>
                </Grid>
                <!-- Choosing a match scrolls the terminal to it: clicking it, also once selected, or the arrows. -->
                <ListView
                    Grid.Row="3"
                    Margin="-12,0"
                    IsItemClickEnabled="True"
                    ItemClick="OnMatchClick"
                    ItemsSource="{x:Bind ViewModel.Find.Matches}"
                    SelectedItem="{x:Bind ViewModel.Find.Selected, Mode=TwoWay}"
                    SelectionChanged="OnMatchSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FindResult">
                            <!-- The line number, then the line with the text found in bold. -->
                            <Grid>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontFamily" Value="Cascadia Mono" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="48" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Line}" />
                                <!-- Side by side: see FindResult for the spaces between them. -->
                                <TextBlock Grid.Column="1" Text="{x:Bind Before}" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind Found}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind After}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Grid.Row="4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Find.Note, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.Find.HasNote, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- Status bar. -->
        <Grid
            Grid.Row="3"
            Padding="12,4"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{x:Bind ViewModel.StatusColor, Mode=OneWay}" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>
            <!-- Back to the bottom, AI assistants, logging, then the device's input lines (bright when on). -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="16">
                <!-- While scrolled up: the terminal is a native window, so no button can float over it. -->
                <HyperlinkButton
                    x:Name="ScrollToBottomButton"
                    Padding="4,0"
                    Click="OnScrollToBottomClick"
                    FontSize="12"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE74B;" />
                        <TextBlock Text="Go to bottom" />
                    </StackPanel>
                </HyperlinkButton>
                <!-- An AI assistant using the tab, and what it did last. -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsAssistantConnected, Mode=OneWay}">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE99A;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.AssistantText, Mode=OneWay}" />
                </StackPanel>
                <!-- Logging to a file. -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsLogging, Mode=OneWay}">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.LogText, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="4,0"
                        Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                        Content="Open folder"
                        FontSize="12" />
                </StackPanel>
                <!-- CTS, DSR and CD. -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}">
                    <TextBlock
                        FontFamily="Cascadia Mono"
                        Opacity="{x:Bind ViewModel.CtsOpacity, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="CTS"
                        ToolTipService.ToolTip="Clear To Send" />
                    <TextBlock
                        FontFamily="Cascadia Mono"
                        Opacity="{x:Bind ViewModel.DsrOpacity, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="DSR"
                        ToolTipService.ToolTip="Data Set Ready" />
                    <TextBlock
                        FontFamily="Cascadia Mono"
                        Opacity="{x:Bind ViewModel.CdOpacity, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="CD"
                        ToolTipService.ToolTip="Carrier Detect" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                FontFamily="Cascadia Mono"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ReceivedText, Mode=OneWay}" />
            <TextBlock
                Grid.Column="3"
                FontFamily="Cascadia Mono"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.SentText, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
