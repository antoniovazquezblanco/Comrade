<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="COMrade.Controls.TrafficPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyDown="OnKeyDown">
    <UserControl.Resources>
        <!-- The columns to show, for the header's Columns button and a right-click on the header. A window of its own, as the tab's other menus. -->
        <MenuFlyout
            x:Key="ColumnsMenu"
            Opening="OnColumnsMenuOpening"
            ShouldConstrainToRootBounds="False">
            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="Time" Text="Time" />
            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="Direction" Text="Dir" />
            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="From" Text="From" />
            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="Hex" Text="Hex" />
            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="Text" Text="Text" />
        </MenuFlyout>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The columns, the way back to the newest rows while scrolled up and the choice of columns: as tall either way, so the rows do not move. -->
        <Grid
            MinHeight="32"
            Padding="8,2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="16"
            ContextFlyout="{StaticResource ColumnsMenu}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="Header"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="Clip" />
            <HyperlinkButton
                x:Name="BottomButton"
                Grid.Column="1"
                Padding="4,0"
                Click="OnBottomClick"
                FontSize="12"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE74B;" />
                    <TextBlock Text="Go to bottom" />
                </StackPanel>
            </HyperlinkButton>
            <DropDownButton
                Grid.Column="2"
                Padding="8,2"
                VerticalAlignment="Center"
                AutomationProperties.Name="Columns"
                Flyout="{StaticResource ColumnsMenu}"
                FontSize="12"
                ToolTipService.ToolTip="Choose the columns to show">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                    <TextBlock Text="Columns" />
                </StackPanel>
            </DropDownButton>
        </Grid>

        <!-- Only the rows on screen exist: a long history costs no more to show than a short one. -->
        <Grid x:Name="Rows" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Canvas
                x:Name="Surface"
                Background="Transparent"
                PointerCaptureLost="OnSurfaceCaptureLost"
                PointerMoved="OnSurfaceMoved"
                PointerPressed="OnSurfacePressed"
                PointerReleased="OnSurfaceReleased"
                PointerWheelChanged="OnSurfaceWheel"
                SizeChanged="OnSurfaceSizeChanged">
                <Canvas.ContextFlyout>
                    <!-- A window of its own, as the tab's other menus: it can show past the window's edge. -->
                    <MenuFlyout Opening="OnMenuOpening" ShouldConstrainToRootBounds="False">
                        <MenuFlyoutItem
                            x:Name="CopyRowsItem"
                            Click="OnCopyRowsClick"
                            Text="Copy rows" />
                        <MenuFlyoutItem
                            x:Name="CopyTextItem"
                            Click="OnCopyTextClick"
                            Text="Copy text only" />
                        <MenuFlyoutItem
                            x:Name="CopyHexItem"
                            Click="OnCopyHexClick"
                            Text="Copy hex only" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem x:Name="ColumnsItem" Text="Columns">
                            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="Time" Text="Time" />
                            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="Direction" Text="Dir" />
                            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="From" Text="From" />
                            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="Hex" Text="Hex" />
                            <ToggleMenuFlyoutItem Click="OnColumnClick" Tag="Text" Text="Text" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Canvas.ContextFlyout>
                <!-- Measures a cell of the font. -->
                <TextBlock
                    x:Name="Probe"
                    IsHitTestVisible="False"
                    Opacity="0" />
            </Canvas>
            <ScrollBar
                x:Name="Scroll"
                Grid.Column="1"
                IndicatorMode="MouseIndicator"
                Orientation="Vertical"
                SmallChange="1"
                ValueChanged="OnScrollChanged" />
        </Grid>
    </Grid>
</UserControl>
