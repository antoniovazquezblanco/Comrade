<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="COMrade.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:COMrade.Views"
    xmlns:vm="using:COMrade.ViewModels"
    Title="COMrade">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabs in the title bar, like Windows Terminal. The tabs only hold headers: each tab's
             contents live in TabContents so that its terminal window is never recreated. -->
        <TabView
            x:Name="Tabs"
            VerticalAlignment="Top"
            AddTabButtonClick="OnAddTabButtonClick"
            AllowDrop="True"
            Background="Transparent"
            CanDragTabs="True"
            CanReorderTabs="True"
            TabDragCompleted="OnTabDragCompleted"
            TabDragStarting="OnTabDragStarting"
            TabDroppedOutside="OnTabDroppedOutside"
            TabStripDragOver="OnTabStripDragOver"
            TabStripDrop="OnTabStripDrop"
            SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
            TabCloseRequested="OnTabCloseRequested"
            TabItemsSource="{x:Bind ViewModel.Tabs}"
            TabWidthMode="SizeToContent">
            <TabView.Resources>
                <!-- 4 + 28 high tabs: the strip is exactly as high as the system caption buttons. -->
                <Thickness x:Key="TabViewHeaderPadding">0,4,0,0</Thickness>
                <x:Double x:Key="TabViewItemMinHeight">28</x:Double>
                <x:Double x:Key="TabViewItemHeaderCloseButtonHeight">20</x:Double>
                <!-- The ports menu of the + button, in a window of its own so that it can cover the terminal. -->
                <MenuFlyout
                    x:Key="PortMenu"
                    Opening="OnPortMenuOpening"
                    Placement="BottomEdgeAlignedLeft"
                    ShouldConstrainToRootBounds="False" />
            </TabView.Resources>
            <TabView.TabStripHeader>
                <!-- As tall as a tab, also while there are no tabs; the icon lines up
                     with the tabs and the + button, which sit at the bottom of the strip. -->
                <Grid Height="32">
                    <Image
                        Width="16"
                        Height="16"
                        Margin="14,0,8,6"
                        VerticalAlignment="Bottom"
                        Source="ms-appx:///Assets/TitleBarIcon.png" />
                </Grid>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Same size and place as the + button: at the bottom of the strip. -->
                    <Button
                        Width="32"
                        Height="24"
                        Margin="0,0,0,2"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="Settings"
                        Click="OnSettingsClick"
                        ToolTipService.ToolTip="Settings (Ctrl+,)">
                        <FontIcon FontSize="12" Glyph="&#xE713;" />
                    </Button>
                    <Grid
                        x:Name="DragRegion"
                        Grid.Column="1"
                        Background="Transparent" />
                </Grid>
            </TabView.TabStripFooter>
            <TabView.TabItemTemplateSelector>
                <views:TabTemplateSelector>
                    <views:TabTemplateSelector.Device>
                        <DataTemplate x:DataType="vm:DeviceTabViewModel">
                            <TabViewItem
                                AutomationProperties.Name="{x:Bind Header, Mode=OneWay}"
                                DoubleTapped="OnTabDoubleTapped"
                                ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                                <TabViewItem.ContextFlyout>
                                    <!-- Windowed: it drops over the terminal, a native window. -->
                                    <MenuFlyout ShouldConstrainToRootBounds="False">
                                        <MenuFlyoutItem Command="{x:Bind StartRenameCommand}" Text="Rename tab">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Command="{x:Bind ResetNameCommand}"
                                            IsEnabled="{x:Bind IsNamed, Mode=OneWay}"
                                            Text="Reset name" />
                                        <MenuFlyoutItem
                                            Click="OnMoveToNewWindowClick"
                                            Tag="{x:Bind}"
                                            Text="Move tab to new window">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Click="OnCloseTabClick"
                                            Tag="{x:Bind}"
                                            Text="Close tab">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </TabViewItem.ContextFlyout>
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{x:Bind StatusColor, Mode=OneWay}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <!-- The box lies over the title, which keeps setting the tab's size while
                                             renaming; the negative margins let it reach around the text and over the
                                             close button without changing the layout. Enter keeps the name, Esc
                                             cancels, an empty name restores the default title. -->
                                        <Grid>
                                            <TextBlock Text="{x:Bind TabTitle, Mode=OneWay}" />
                                            <TextBox
                                                MinWidth="0"
                                                MinHeight="0"
                                                Margin="-8,-3,-34,-3"
                                                Padding="4,2"
                                                VerticalAlignment="Center"
                                                FontSize="{ThemeResource TabViewItemHeaderFontSize}"
                                                KeyDown="OnRenameKeyDown"
                                                Loaded="OnRenameBoxLoaded"
                                                LostFocus="OnRenameLostFocus"
                                                PlaceholderText="{x:Bind PortName, Mode=OneWay}"
                                                Tag="{x:Bind}"
                                                Text="{x:Bind Header, Mode=OneWay}"
                                                Visibility="{x:Bind IsRenaming, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </TabViewItem.Header>
                            </TabViewItem>
                        </DataTemplate>
                    </views:TabTemplateSelector.Device>
                    <views:TabTemplateSelector.Settings>
                        <DataTemplate x:DataType="vm:SettingsTabViewModel">
                            <TabViewItem AutomationProperties.Name="{x:Bind Header}">
                                <TabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="12" Glyph="&#xE713;" />
                                        <TextBlock Text="{x:Bind TabTitle, Mode=OneWay}" />
                                    </StackPanel>
                                </TabViewItem.Header>
                            </TabViewItem>
                        </DataTemplate>
                    </views:TabTemplateSelector.Settings>
                </views:TabTemplateSelector>
            </TabView.TabItemTemplateSelector>
        </TabView>

        <Grid
            x:Name="TabContents"
            Grid.Row="1"
            Background="{ThemeResource TabViewItemHeaderBackgroundSelected}">
            <views:PortPickerView
                x:Name="PortPicker"
                PortSelected="OnPortSelected"
                ViewModel="{x:Bind ViewModel.PortList}"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
